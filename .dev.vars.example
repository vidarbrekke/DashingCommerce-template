# Copy to `.dev.vars` for local Wrangler / Cloudflare Worker dev.
# Do not commit `.dev.vars` — it contains secrets.

# Public site URL (redirects, webhook callbacks in Worker dev)
EMDASH_SITE_URL=http://localhost:8787

# Optional — Stripe sandbox verification (see packages/plugins/dashing-commerce/docs/STRIPE_VALIDATION.md)
# STRIPE_TEST_SECRET_KEY=sk_test_...
# STRIPE_TEST_WEBHOOK_SECRET=whsec_...
# STRIPE_E2E=1

# Optional — admin HTTP verifier (pnpm verify:admin:strict:local)
# EMDASH_BASE_URL=http://localhost:4321
# EMDASH_ADMIN_BEARER=
