---
/**
 * Dedicated PayPal payment page.
 * Loads order, renders PayPal JS SDK button, handles create-order -> capture -> status redirect.
 */
import { getPluginSetting } from "emdash";
import { PhaseOneCommerceError } from "@emdash-cms/plugin-dashing-commerce/contracts/phase-1-clients";

import Base from "../../layouts/Base.astro";
import { buildShopClientFromAstro } from "../../lib/commerce/client";
import {
	ORDER_ID_PARAM,
	FINALIZE_TOKEN_PARAM,
	formatCustomerOrderReference,
} from "../../lib/commerce/cart";

const client = buildShopClientFromAstro(Astro);

const orderIdVal = Astro.url.searchParams.get(ORDER_ID_PARAM)?.trim() ?? "";
const finalizeTokenVal = Astro.url.searchParams.get(FINALIZE_TOKEN_PARAM)?.trim() ?? "";

if (!orderIdVal || !finalizeTokenVal) {
	return Astro.redirect("/shop/cart");
}

const checkoutResumeHref = `/shop/checkout?${new URLSearchParams({
	[ORDER_ID_PARAM]: orderIdVal,
	[FINALIZE_TOKEN_PARAM]: finalizeTokenVal,
}).toString()}`;
const orderReference = formatCustomerOrderReference(orderIdVal);

let fetchError: string | null = null;
let orderCurrency = "USD";
const paypalClientIdRaw = await getPluginSetting<string>("commerce", "paypalClientId");
const paypalClientIdFromSettings =
	typeof paypalClientIdRaw === "string" ? paypalClientIdRaw.trim() : "";
const paypalClientId =
	paypalClientIdFromSettings ||
	(typeof import.meta.env.PAYPAL_CLIENT_ID === "string" ? import.meta.env.PAYPAL_CLIENT_ID.trim() : "") ||
	"";

try {
	const loaded = await client.getOrder({ orderId: orderIdVal, finalizeToken: finalizeTokenVal });
	if (loaded.order.paymentPhase !== "initiated") {
		fetchError = "This order is no longer awaiting payment.";
	} else if (loaded.order.providerId !== "paypal") {
		fetchError = "This order is not configured for PayPal payment.";
	} else if (!paypalClientId) {
		fetchError = "PayPal client ID is not configured in commerce payment settings.";
	} else {
		orderCurrency = loaded.order.currency;
	}
} catch (err) {
	if (err instanceof PhaseOneCommerceError) {
		fetchError = err.message;
	} else {
		fetchError = err instanceof Error ? err.message : "Failed to load order";
	}
}
---

<Base title="Complete payment">
	<div class="container paypal-page">
		{fetchError ? (
			<div class="alert alert-error">{fetchError}</div>
		) : (
			<>
				<div class="page-header">
					<h1>Complete payment</h1>
					<p>Order reference <strong>{orderReference}</strong></p>
				</div>

				<div class="paypal-container">
					<div id="paypal-button-container"></div>
					<p id="paypal-error" class="alert alert-error" hidden></p>
					<p id="paypal-cancel-notice" class="alert alert-info" hidden>
						Payment canceled. You can try again, or go back to adjust your order.
					</p>
					<p class="paypal-hint">You will be redirected to PayPal to complete your purchase.</p>
				</div>

				<nav class="paypal-nav" aria-label="Checkout navigation">
					<a href={checkoutResumeHref} class="paypal-back">← Back to checkout</a>
					<a href="/shop/cart" class="paypal-back">Leave payment · return to cart</a>
				</nav>

				<div
					id="paypal-config"
					data-order-id={orderIdVal}
					data-finalize-token={finalizeTokenVal}
					data-currency={orderCurrency}
					data-api-base={`${Astro.url.origin}/_emdash/api/plugins/commerce`}
					hidden
				></div>

				<script
					is:inline
					src={`https://www.paypal.com/sdk/js?client-id=${encodeURIComponent(paypalClientId)}&components=buttons&currency=${encodeURIComponent(orderCurrency)}`}
				></script>

				<script>
					import { buildStatusHref } from "../../lib/commerce/order-status.ts";

					const cfg = document.getElementById("paypal-config")!;
					const orderId = cfg.getAttribute("data-order-id") ?? "";
					const finalizeToken = cfg.getAttribute("data-finalize-token") ?? "";
					const apiBase = cfg.getAttribute("data-api-base") ?? "";

					const errorEl = document.getElementById("paypal-error");
					const cancelEl = document.getElementById("paypal-cancel-notice");

					function showError(message: string) {
						if (cancelEl) cancelEl.hidden = true;
						if (errorEl) {
							errorEl.hidden = false;
							errorEl.textContent = message;
						}
					}

					function clearError() {
						if (errorEl) {
							errorEl.hidden = true;
							errorEl.textContent = "";
						}
					}

					function showCanceled() {
						clearError();
						if (cancelEl) cancelEl.hidden = false;
					}

					async function callApi(route: string, body: Record<string, unknown>) {
						const res = await fetch(`${apiBase}/${route}`, {
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								"X-EmDash-Request": "1",
							},
							body: JSON.stringify(body),
						});
						const data = await res.json().catch(() => ({}));
						if (!res.ok) {
							const err = data.error || data;
							throw new Error(err?.message || `Request failed: ${res.status}`);
						}
						return data.data || data;
					}

					function navigateToStatus(attemptId: string | undefined) {
						if (attemptId) {
							window.location.href = buildStatusHref(orderId, attemptId, "paypal", finalizeToken);
						} else {
							window.location.href = buildStatusHref(orderId, undefined, "paypal", finalizeToken);
						}
					}

					async function initPayPal() {
						const container = document.getElementById("paypal-button-container");
						if (!container || !(window as unknown as { paypal?: unknown }).paypal) {
							showError("PayPal SDK failed to load.");
							return;
						}

						(window as unknown as { paypal?: { Buttons: (config: {
							createOrder: () => Promise<string>;
							onApprove: (data: { orderID: string }) => Promise<void>;
							onCancel: () => void;
							onError: (err: unknown) => void;
						}) => { render: (sel: string) => void } } }).paypal?.Buttons({
							createOrder: async () => {
								clearError();
								if (cancelEl) cancelEl.hidden = true;
								try {
									const res = await callApi("payment/paypal/create-order", {
										orderId,
										finalizeToken,
									});
									return res.paypalOrderId;
								} catch (err) {
									showError(err instanceof Error ? err.message : "Failed to create PayPal order.");
									throw err;
								}
							},
							onApprove: async (data: { orderID: string }) => {
								clearError();
								if (cancelEl) cancelEl.hidden = true;
								try {
									const res = await callApi("payment/paypal/capture-order", {
										orderId,
										finalizeToken,
										paypalOrderId: data.orderID,
									});
									navigateToStatus(res.paymentAttemptId);
								} catch (err) {
									showError(err instanceof Error ? err.message : "Failed to capture PayPal order.");
								}
							},
							onCancel: () => {
								showCanceled();
							},
							onError: (err: unknown) => {
								console.error("PayPal error:", err);
								showError("PayPal checkout error. Please try again.");
							},
						}).render("#paypal-button-container");
					}

					if ((window as unknown as { paypal?: unknown }).paypal) {
						void initPayPal();
					} else {
						window.addEventListener("load", () => {
							if ((window as unknown as { paypal?: unknown }).paypal) void initPayPal();
						});
					}
				</script>
			</>
		)}
	</div>
</Base>