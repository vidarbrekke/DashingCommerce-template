---
import Base from "../../layouts/Base.astro";
import ProductLayout from "../../components/commerce/ProductLayout.astro";
import { loadProductDetailPage, isProductDetailView } from "../../lib/commerce/product-detail-page";
import { resolveStorefrontAppearance } from "../../lib/commerce/storefront-appearance";

const slug = Astro.params.slug;
if (slug === undefined || slug.length === 0) {
	return Astro.redirect("/shop");
}

const pageResult = await loadProductDetailPage(
	Astro.request,
	slug,
	Astro.url.origin,
	Astro.locals.emdash?.handlePublicPluginApiRoute,
);
if (pageResult instanceof Response) {
	return pageResult;
}

const appearance = await resolveStorefrontAppearance();
const pageTitle =
	pageResult.detail?.product.title ?? (pageResult.fetchError ? "Product" : "Product");
---

<Base title={pageTitle} skin={appearance.storefrontSkin}>
	<div class="container">
		{pageResult.fetchError && (
			<div style="padding: 3rem 0;">
				<div class="alert alert-error">{pageResult.fetchError}</div>
				<a href="/shop" class="btn btn-secondary">← Back to shop</a>
			</div>
		)}

		{isProductDetailView(pageResult) && (
			<ProductLayout view={pageResult} layoutId={appearance.productLayout} />
		)}
	</div>
</Base>
