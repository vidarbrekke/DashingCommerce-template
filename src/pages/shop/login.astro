---
import Base from "../../layouts/Base.astro";

const returnTo = Astro.url.searchParams.get("redirect") ?? "/shop/my-account";
const safeReturn =
	returnTo.startsWith("/") && !returnTo.startsWith("//") && !returnTo.includes("\\")
		? returnTo
		: "/shop/my-account";
const loginHref = `/_emdash/admin/login?redirect=${encodeURIComponent(safeReturn)}`;
---

<Base title="Sign in">
	<div class="container">
		<div class="page-header">
			<h1>Sign in</h1>
		</div>

		<div class="card" style="max-width:28rem;">
			<p style="font-size:0.9rem; color:var(--color-muted); margin-bottom:1.25rem;">
				Sign in to view your orders and account details.
			</p>
			<a href={loginHref} class="btn btn-primary" style="width:100%; justify-content:center;">
				Continue to sign in
			</a>
		</div>
	</div>
</Base>
