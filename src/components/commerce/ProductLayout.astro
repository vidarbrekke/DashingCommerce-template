---
import ProductCatalogMeta from "../ProductCatalogMeta.astro";
import { formatPrice } from "../../lib/commerce/cart";
import type { ProductDetailView } from "../../lib/commerce/product-detail-page";
import type { ProductLayoutId } from "../../lib/commerce/storefront-appearance";

interface Props {
	view: ProductDetailView;
	layoutId?: ProductLayoutId;
}

const { view, layoutId = "classic" } = Astro.props;
const layoutClass = layoutId === "stacked" ? "product-layout-stacked" : "two-col";
const {
	detail,
	cartError,
	storefrontPriceLine,
	storefrontCompareLine,
	heroDisplayUrl,
	heroImageAlt,
	galleryImages,
	galleryMainSrc,
	galleryThumbSrc,
	variantImageBySkuRecord,
	selectedSkuForPage,
	selectedSkuIdForPage,
	selectedSkuPriceLabel,
	selectedSkuCompareLabel,
	showLivePrice,
	useCascadingVariantPicker,
	variantPickerConfig,
	describeSkuFulfillment,
	selectedSkuFulfillment,
	selectedStockLabel,
	isAddDisabled,
	defaultOrderQuantityMax,
	showQuantityField,
	stockStateBySkuRecord,
} = view;
---

<div style="padding: 2rem 0 3rem;">
	<a href="/shop" style="font-size:0.875rem; color:var(--color-muted);">← Back to shop</a>

	<div class={layoutClass} style="margin-top:1.5rem;">
		<div>
			<div style="background:var(--color-bg); border:1px solid var(--color-border); border-radius:var(--radius); aspect-ratio:4/3; display:flex; align-items:center; justify-content:center; color:var(--color-muted); font-size:0.9rem; overflow:hidden;">
				{heroDisplayUrl ? (
					<img
						id="product-main-image"
						src={heroDisplayUrl}
						alt={heroImageAlt}
						style="width:100%; height:100%; object-fit:cover;"
					/>
				) : (
					<img
						src="/no-image.svg"
						alt="No image available"
						style="width: 90%; height: 90%; object-fit: contain;"
					/>
				)}
			</div>

			{galleryImages.length > 0 && (
				<div class="product-gallery-thumbs" style="display:flex; gap:0.5rem; margin-top:0.75rem; flex-wrap:wrap;">
					{galleryImages.map((img) => (
						<button
							type="button"
							class="product-gallery-thumb"
							data-product-gallery-thumb
							data-product-gallery-src={galleryMainSrc(img.externalAssetId)}
							data-product-gallery-alt={img.altText ?? detail.product.title}
							aria-label={`Show ${img.altText ?? "gallery image"}`}
							style="padding:0; border:1px solid var(--color-border); border-radius:var(--radius); overflow:hidden; background:none; cursor:pointer;"
						>
							<img
								src={galleryThumbSrc(img.externalAssetId)}
								alt={img.altText ?? ""}
								style="width:72px; height:72px; object-fit:cover;"
								loading="lazy"
							/>
						</button>
					))}
					{detail.primaryImage && detail.primaryImage.externalAssetId !== (detail.heroImageUrl ?? "") ? (
						<button
							type="button"
							class="product-gallery-thumb"
							data-product-gallery-thumb
							data-product-gallery-src={galleryMainSrc(detail.primaryImage.externalAssetId)}
							data-product-gallery-alt={detail.primaryImage.altText ?? detail.product.title}
							aria-label={`Show ${detail.primaryImage.altText ?? detail.product.title}`}
							style="padding:0; border:1px solid var(--color-border); border-radius:var(--radius); overflow:hidden; background:none; cursor:pointer;"
						>
							<img
								src={galleryThumbSrc(detail.primaryImage.externalAssetId)}
								alt={detail.primaryImage.altText ?? ""}
								style="width:72px; height:72px; object-fit:cover;"
								loading="lazy"
							/>
						</button>
					) : null}
				</div>
			)}
		</div>

		<div>
			<h1 style="font-size:1.5rem; font-weight:700; letter-spacing:-0.02em;">{detail.product.title}</h1>

			{detail.product.shortDescription && (
				<p style="margin-top:0.75rem; font-size:0.95rem; color:var(--color-muted);">
					{detail.product.shortDescription}
				</p>
			)}

			{(storefrontPriceLine || showLivePrice) && (
				<div style="margin-top:1.25rem;">
					<p style="font-size:1.35rem; font-weight:700;">
						<span data-variant-picker-price={showLivePrice ? "" : undefined}>
							{showLivePrice ? selectedSkuPriceLabel : storefrontPriceLine}
						</span>
						{(showLivePrice ? selectedSkuCompareLabel : storefrontCompareLine) !== null && (
							<span
								data-variant-picker-compare={showLivePrice ? "" : undefined}
								style="font-size:0.9rem; font-weight:400; color:var(--color-muted); text-decoration:line-through; margin-inline-start:0.5rem;"
								hidden={showLivePrice ? selectedSkuCompareLabel === null : storefrontCompareLine === null}
							>
								{showLivePrice
									? selectedSkuCompareLabel
									: storefrontCompareLine !== null
										? formatPrice(storefrontCompareLine)
										: ""}
							</span>
						)}
					</p>
				</div>
			)}

			{cartError && <div class="alert alert-error" style="margin-top:1rem;">{cartError}</div>}

			{detail.skus && detail.skus.length > 0 ? (
				<form method="POST" style="margin-top:1.25rem; display:flex; flex-direction:column; gap:0.75rem;">
					{detail.skus.length > 1 && useCascadingVariantPicker && variantPickerConfig && (
						<div
							class="variant-picker"
							data-variant-picker
							data-variant-picker-config={JSON.stringify(variantPickerConfig)}
							data-hero-image-url={heroDisplayUrl}
							style="display:flex; flex-direction:column; gap:0.75rem;"
						>
							{variantPickerConfig.attributes.map((attribute, attributeIndex) => (
								<div class="form-group">
									<label for={`variant-opt-${attribute.id}`}>{attribute.name}</label>
									<select
										id={`variant-opt-${attribute.id}`}
										data-variant-option-select
										data-attribute-id={attribute.id}
										data-attribute-index={attributeIndex}
										disabled={attributeIndex > 0}
									>
										<option value="">Choose {attribute.name}</option>
									</select>
								</div>
							))}
							<input
								type="hidden"
								name="skuId"
								id="skuId"
								data-variant-picker-sku
								value=""
							/>
						</div>
					)}
					{detail.skus.length > 1 && !useCascadingVariantPicker && (
						<div class="form-group">
							<label for="skuId">
								{detail.product.type === "variable" ? "Options" : "Variant"}
							</label>
							<select name="skuId" id="skuId" data-product-sku-select>
								{detail.skus
									.filter((s) => s.status === "active")
									.map((sku) => (
										<option value={sku.id}>
											{sku.variantLabel ?? sku.skuCode}
											{` — ${describeSkuFulfillment(sku)}`}
											{` — ${sku.stockLabel}`}
											— {formatPrice(sku.unitPriceMinor)}
										</option>
									))}
							</select>
						</div>
					)}
					{selectedSkuForPage && (
						<p
							data-variant-picker-fulfillment={useCascadingVariantPicker ? "" : undefined}
							style="margin-top:0.25rem; font-size:0.85rem; color:var(--color-muted);"
						>
							Fulfillment: {selectedSkuFulfillment}
						</p>
					)}
					{detail.skus.length === 1 && (
						<input type="hidden" name="skuId" value={detail.skus[0]!.id} />
					)}

					<div
						class="form-group"
						data-product-quantity-field
						hidden={!showQuantityField}
						style="max-width:120px;"
					>
						<label for="quantity">Quantity</label>
						<p
							id="product-stock-status"
							style={`margin-top:0.25rem; font-size:0.8rem; color:${isAddDisabled ? "var(--color-danger)" : "var(--color-muted)"}`}
						>
							{selectedStockLabel}
						</p>
						<input
							type="number"
							name="quantity"
							id="quantity"
							min="1"
							max={defaultOrderQuantityMax}
							value={isAddDisabled ? "0" : "1"}
							disabled={isAddDisabled}
						/>
					</div>

					<button
						type="submit"
						id="product-add-to-cart"
						class="btn btn-primary"
						style="width:fit-content;"
						disabled={isAddDisabled}
					>
						Add to cart
					</button>
				</form>
			) : (
				<p style="margin-top:1rem; color:var(--color-muted);">Not available</p>
			)}

			{(detail.brand || (detail.categories && detail.categories.length > 0)) && (
				<div style="margin-top:1.5rem;">
					<ProductCatalogMeta brand={detail.brand} categories={detail.categories ?? []} />
				</div>
			)}
			{detail.tags && detail.tags.length > 0 && (
				<div style="margin-top:0.4rem; font-size:0.85rem; color:var(--color-muted);">
					Tags: {detail.tags.map((t) => t.name).join(", ")}
				</div>
			)}
		</div>
	</div>
</div>

<script
	is:inline
	define:vars={{
		variantImageBySkuRecord,
		heroImageUrl: heroDisplayUrl,
		selectedSkuIdForPage,
		stockStateBySkuRecord,
		cascadingPickerEnabled: useCascadingVariantPicker,
	}}
>
const mainImage = document.querySelector("#product-main-image");
const galleryButtons = [...document.querySelectorAll("[data-product-gallery-thumb]")];
const skuSelect = document.querySelector("[data-product-sku-select]");
const activeClass = "is-active";
const stockMessage = document.querySelector("#product-stock-status");
const addToCartButton = document.querySelector("#product-add-to-cart");
const quantityInput = document.querySelector("#quantity");
const allSkuStockState = stockStateBySkuRecord || {};
const hasCascadingVariantPicker = Boolean(cascadingPickerEnabled);

const setQuantityStateFromStock = (skuId) => {
	const state = allSkuStockState[skuId] ?? { label: "Out of stock", max: 0 };
	const inStock = state.max > 0;

	if (stockMessage) {
		stockMessage.textContent = state.label;
		stockMessage.style.color = inStock ? "var(--color-muted)" : "var(--color-danger)";
	}

	if (addToCartButton instanceof HTMLButtonElement) {
		addToCartButton.disabled = !inStock;
	}

	if (quantityInput instanceof HTMLInputElement) {
		quantityInput.max = String(inStock ? state.max : 1);
		quantityInput.disabled = !inStock;
		if (inStock) {
			const currentQuantity = Number(quantityInput.value);
			if (Number.isFinite(currentQuantity) && currentQuantity > state.max) {
				quantityInput.value = String(Math.max(1, state.max));
			}
		} else {
			quantityInput.value = "0";
		}
	}
};

if (!hasCascadingVariantPicker) {
	setQuantityStateFromStock(selectedSkuIdForPage);
}

const resetActiveState = (activeButton) => {
	galleryButtons.forEach((button) => {
		button.classList.toggle(activeClass, button === activeButton);
	});
};

const initialButton =
	galleryButtons.find((button) => button.dataset.productGallerySrc === mainImage?.getAttribute("src")) ??
	galleryButtons[0];
resetActiveState(initialButton ?? null);

for (const button of galleryButtons) {
	button.addEventListener("click", () => {
		if (!mainImage) {
			return;
		}
		const nextSrc = button.dataset.productGallerySrc;
		if (!nextSrc) {
			return;
		}
		mainImage.src = nextSrc;
		mainImage.alt = button.dataset.productGalleryAlt ?? mainImage.alt;
		resetActiveState(button);
	});
}

skuSelect?.addEventListener("change", () => {
	if (!mainImage || !(skuSelect instanceof HTMLSelectElement)) {
		return;
	}
	const variantUrl = variantImageBySkuRecord[skuSelect.value];
	const nextSrc =
		typeof variantUrl === "string" && variantUrl.length > 0 ? variantUrl : heroImageUrl;
	if (nextSrc) {
		mainImage.src = nextSrc;
	}
	setQuantityStateFromStock(skuSelect.value);
	resetActiveState(null);
});
</script>

<style>
	.product-layout-stacked {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		max-width: 40rem;
	}

	.variant-picker select {
		width: 100%;
		max-width: 22rem;
	}

	#product-main-image {
		transition: opacity 120ms ease;
	}

	.product-gallery-thumb {
		width: 72px;
		height: 72px;
		border: 1px solid transparent;
		border-radius: var(--radius);
		cursor: pointer;
		background: none;
		padding: 0;
	}

	.product-gallery-thumb.is-active {
		border-color: var(--color-primary);
		outline: 2px solid color-mix(in srgb, var(--color-primary), transparent 70%);
		outline-offset: 2px;
	}
</style>

{useCascadingVariantPicker && (
	<script>
		import("../../lib/commerce/storefront-variant-picker-init.ts");
	</script>
)}
