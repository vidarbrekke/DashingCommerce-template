{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "DashingCommerce Storefront",
		"description": "Commerce demo with product catalog",
		"author": "DashingCommerce"
	},
	"settings": {
		"title": "DashingCommerce Demo",
		"tagline": "Modern commerce, powered by EmDash"
	},
	"menus": [
		{
			"name": "primary",
			"label": "Primary Navigation",
			"items": [
				{ "type": "custom", "label": "Shop", "url": "/shop" },
				{ "type": "custom", "label": "About", "url": "/pages/about" },
				{ "type": "custom", "label": "Cart", "url": "/shop/cart" },
				{ "type": "custom", "label": "Account", "url": "/shop/my-account" }
			]
		}
	],
	"collections": [
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"supports": ["drafts", "revisions", "search"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],
	"content": {
		"pages": [
			{
				"id": "about",
				"slug": "about",
				"status": "published",
				"data": {
					"title": "About",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "This demo storefront shares one site shell (header, footer, and global styles) with the shop. CMS pages like this one use the same Base layout as product and cart pages.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						}
					]
				}
			}
		]
	}
}
